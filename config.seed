CONFIG_TARGET_ipq806x=y
CONFIG_TARGET_ipq806x_generic=y
CONFIG_TARGET_ipq806x_generic_DEVICE_norton_core-518=y
CONFIG_TARGET_ipq806x_generic_DEVICE_norton_core-518-alt=y
CONFIG_TARGET_MULTI_PROFILE=n
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_TARGZ=n
CONFIG_TARGET_IMAGES_GZIP=n

# LuCI
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-proto-pppoe=y
CONFIG_PACKAGE_luci-proto-dhcp=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# 常用工具
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_e2fsprogs=y

# 无线：QCA9984（板载两颗）
CONFIG_PACKAGE_ath10k-firmware-qca9984-ct=y
CONFIG_PACKAGE_kmod-ath10k-ct=y
CONFIG_PACKAGE_wpad-openssl=y
